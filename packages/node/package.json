{
  "name": "@manalens/node",
  "version": "0.2.1",
  "description": "Manalens for Node.js: server events and Electron main-process app events.",
  "keywords": [
    "game-analytics",
    "server-side-analytics",
    "electron",
    "analytics",
    "attribution",
    "sdk",
    "nodejs"
  ],
  "homepage": "https://github.com/manalens/manalens-js/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/manalens/manalens-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manalens/manalens-js.git",
    "directory": "packages/node"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
