{
  "name": "@manalens/web",
  "version": "0.1.0",
  "description": "Manalens Web SDK: first-party web analytics and attribution. Track page views, custom events, identified users, UTM parameters and ad click IDs in your website or web app.",
  "keywords": [
    "web-analytics",
    "product-analytics",
    "marketing-attribution",
    "attribution",
    "utm",
    "click-id",
    "first-party",
    "analytics",
    "sdk"
  ],
  "homepage": "https://github.com/manalens/manalens-js/tree/main/packages/web#readme",
  "bugs": {
    "url": "https://github.com/manalens/manalens-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manalens/manalens-js.git",
    "directory": "packages/web"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./snippet": "./dist/snippet.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/snippet.js",
    "./dist/snippet.global.js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/snippet.ts --format esm --dts --clean --out-dir dist && tsup src/snippet.ts --format iife --global-name Manalens --out-dir dist",
    "typecheck": "tsc --noEmit",
    "example": "pnpm build && node examples/server.mjs",
    "test:example": "pnpm build && node --test examples/smoke.mjs",
    "test": "pnpm test:example",
    "sri": "bash scripts/generate-sri.sh"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
